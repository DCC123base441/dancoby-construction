{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Name of the client"
    },
    "role": {
      "type": "string",
      "description": "Role or title of the client (e.g., Homeowner, Business Owner)"
    },
    "quote": {
      "type": "string",
      "description": "The testimonial quote from the client"
    },
    "project_id": {
      "type": "string",
      "description": "ID of the related project"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sort order for display"
    }
  },
  "required": [
    "client_name",
    "quote"
  ]
}