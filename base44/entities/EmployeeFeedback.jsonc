{
  "name": "EmployeeFeedback",
  "type": "object",
  "properties": {
    "userEmail": {
      "type": "string",
      "description": "Email of the employee"
    },
    "content": {
      "type": "string",
      "description": "Feedback content"
    },
    "category": {
      "type": "string",
      "enum": [
        "safety",
        "culture",
        "tools",
        "management",
        "other"
      ],
      "default": "other",
      "description": "Feedback category"
    },
    "isAnonymous": {
      "type": "boolean",
      "default": false,
      "description": "Whether the feedback is anonymous"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "Whether this feedback has been resolved"
    },
    "adminReply": {
      "type": "string",
      "description": "Admin reply/message to the employee"
    }
  },
  "required": [
    "content"
  ]
}