{
  "name": "Standard",
  "type": "object",
  "properties": {
    "imageUrl": {
      "type": "string",
      "description": "URL of the uploaded image"
    },
    "note": {
      "type": "string",
      "description": "Note for the image (e.g. 'This', 'Not This')"
    },
    "category": {
      "type": "string",
      "description": "Optional category grouping"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "imageUrl",
    "note"
  ]
}