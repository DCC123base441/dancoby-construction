{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "category": {
      "type": "string",
      "enum": [
        "Residential",
        "Commercial",
        "Renovation",
        "Restoration"
      ],
      "description": "Project category"
    },
    "description": {
      "type": "string",
      "description": "Detailed project description"
    },
    "logoText": {
      "type": "string",
      "description": "Logo/label text for the project"
    },
    "mainImage": {
      "type": "string",
      "description": "Main project image URL"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of project image URLs for gallery"
    },
    "budget": {
      "type": "string",
      "description": "Project budget (e.g., '$500K - $750K')"
    },
    "timeline": {
      "type": "string",
      "description": "Project timeline (e.g., '8 months')"
    },
    "location": {
      "type": "string",
      "description": "Project location"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of materials used"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key project highlights"
    },
    "testimonials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      },
      "description": "Client testimonials"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether to feature on home page"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sort order for projects"
    }
  },
  "required": [
    "title",
    "category",
    "description"
  ]
}