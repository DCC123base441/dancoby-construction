{
  "name": "HomePageContent",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "hero",
        "whoWeAre",
        "services",
        "aboutUs",
        "banner",
        "featuredProjects",
        "cta"
      ],
